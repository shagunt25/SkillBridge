# Required for startup.
MONGODB_URI=your_mongodb_connection_string_here
DATABASE_NAME=skillbridge

# Use a random secret with at least 32 bytes (for example: token_hex(32)).
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_MINUTES=60

COOKIE_NAME=skillbridge_auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated exact frontend origins, without paths.
FRONTEND_URL=http://localhost:3000

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_IP_MAX_REQUESTS=10
OTP_RATE_LIMIT_EMAIL_MAX_REQUESTS=5

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_EMAIL_IP_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=30

AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_USER_MAX_REQUESTS=20

# Local development only: prints OTPs to the backend terminal.
# Set to smtp and fill in the credentials below to send real email.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Required when EMAIL_BACKEND=smtp. Use a dedicated Gmail account.
SMTP_USERNAME=
# Use the Google App Password, not your Gmail account password.
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left empty.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillBridge
SMTP_TIMEOUT_SECONDS=10

GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=

